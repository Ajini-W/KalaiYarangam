// ═══════════════════════════════════════════════════════════════
// 9. FINANCE / ACCOUNTING FOUNDATION
// ═══════════════════════════════════════════════════════════════

model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  branchId      String?       @map("branch_id") @db.Uuid
  studentId     String?       @map("student_id") @db.Uuid
  invoiceNumber String        @map("invoice_number") @db.VarChar(50)
  description   String?       @db.Text
  subtotal      Decimal       @db.Decimal(10, 2)
  discount      Decimal       @default(0) @db.Decimal(10, 2)
  tax           Decimal       @default(0) @db.Decimal(10, 2)
  totalAmount   Decimal       @map("total_amount") @db.Decimal(10, 2)
  paidAmount    Decimal       @default(0) @map("paid_amount") @db.Decimal(10, 2)
  currency      String        @default("INR") @db.VarChar(3)
  status        InvoiceStatus @default(DRAFT)
  issueDate     DateTime      @default(now()) @map("issue_date") @db.Date
  dueDate       DateTime      @map("due_date") @db.Date
  paidAt        DateTime?     @map("paid_at")
  notes         String?       @db.Text
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch?       @relation(fields: [branchId], references: [id])
  student      Student?      @relation(fields: [studentId], references: [id])
  transactions Transaction[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@index([status])
  @@map("invoices")
}

model ExpenseCategory {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String   @db.VarChar(100)
  code      String?  @db.VarChar(20)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([tenantId, name])
  @@map("expense_categories")
}

model Transaction {
  id                String          @id @default(uuid()) @db.Uuid
  tenantId          String          @map("tenant_id") @db.Uuid
  invoiceId         String?         @map("invoice_id") @db.Uuid
  expenseCategoryId String?         @map("expense_category_id") @db.Uuid
  type              TransactionType
  amount            Decimal         @db.Decimal(10, 2)
  currency          String          @default("INR") @db.VarChar(3)
  mode              PaymentMode     @default(CASH)
  reference         String?         @db.VarChar(255)
  description       String?         @db.Text
  transactionDate   DateTime        @default(now()) @map("transaction_date")
  createdAt         DateTime        @default(now()) @map("created_at")

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice         Invoice?         @relation(fields: [invoiceId], references: [id])
  expenseCategory ExpenseCategory? @relation(fields: [expenseCategoryId], references: [id])

  @@index([tenantId])
  @@index([type])
  @@index([transactionDate])
  @@map("transactions")
}

// ═══════════════════════════════════════════════════════════════
// 10. CERTIFICATE MANAGEMENT
// ═══════════════════════════════════════════════════════════════

model CertificateTemplate {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  name         String   @db.VarChar(200)
  htmlContent  String   @map("html_content") @db.Text
  cssStyles    String?  @map("css_styles") @db.Text
  variables    Json?    /// Template variables schema
  orientation  String   @default("landscape") @db.VarChar(10)
  paperSize    String   @default("A4") @map("paper_size") @db.VarChar(10)
  isDefault    Boolean  @default(false) @map("is_default")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  certificates Certificate[]

  @@index([tenantId])
  @@map("certificate_templates")
}

model Certificate {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  studentId   String   @map("student_id") @db.Uuid
  templateId  String   @map("template_id") @db.Uuid
  certNumber  String   @unique @map("cert_number") @db.VarChar(50)
  courseName  String   @map("course_name") @db.VarChar(200)
  issuedDate  DateTime @map("issued_date") @db.Date
  pdfUrl      String?  @map("pdf_url") @db.VarChar(500)
  data        Json?    /// Rendered data snapshot
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant        Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student       Student                 @relation(fields: [studentId], references: [id])
  template      CertificateTemplate     @relation(fields: [templateId], references: [id])
  verifications CertificateVerification[]

  @@index([tenantId])
  @@map("certificates")
}

model CertificateVerification {
  id            String   @id @default(uuid()) @db.Uuid
  certificateId String   @map("certificate_id") @db.Uuid
  verifiedBy    String?  @db.VarChar(255)
  ipAddress     String?  @map("ip_address") @db.VarChar(45)
  verifiedAt    DateTime @default(now()) @map("verified_at")

  certificate Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)

  @@index([certificateId])
  @@map("certificate_verifications")
}

// ═══════════════════════════════════════════════════════════════
// 11. REPORTING & ANALYTICS
// ═══════════════════════════════════════════════════════════════

model DashboardWidget {
  id        String  @id @default(uuid()) @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  title     String  @db.VarChar(200)
  type      String  @db.VarChar(50) /// chart, counter, table, etc.
  config    Json    /// Widget configuration
  position  Int     @default(0)
  isVisible Boolean @default(true) @map("is_visible")
  roles     UserRole[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("dashboard_widgets")
}

model AnalyticsSnapshot {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  metric     String   @db.VarChar(100)
  value      Decimal  @db.Decimal(12, 2)
  dimensions Json?    /// Filters/dimensions for the metric
  snapshotDate DateTime @map("snapshot_date") @db.Date
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, metric, snapshotDate])
  @@index([tenantId])
  @@map("analytics_snapshots")
}

// ═══════════════════════════════════════════════════════════════
// 12. BULK OPERATIONS JOB TRACKING
// ═══════════════════════════════════════════════════════════════

model BulkJob {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  type           String   @db.VarChar(50) /// STUDENT_IMPORT, STUDENT_EXPORT, ATTENDANCE, TASKS, CERTIFICATES
  status         String   @default("PENDING") @db.VarChar(20) /// PENDING, PROCESSING, COMPLETED, FAILED
  totalItems     Int      @default(0) @map("total_items")
  processedItems Int      @default(0) @map("processed_items")
  failedItems    Int      @default(0) @map("failed_items")
  result         Json?    /// Summary / errors / output data
  startedAt      DateTime? @map("started_at")
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@map("bulk_jobs")
}
