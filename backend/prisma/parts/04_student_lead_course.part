// ═══════════════════════════════════════════════════════════════
// 4. STUDENT MANAGEMENT
// ═══════════════════════════════════════════════════════════════

model Student {
  id             String           @id @default(uuid()) @db.Uuid
  tenantId       String           @map("tenant_id") @db.Uuid
  registrationNo String?         @unique @map("registration_no") @db.VarChar(50)
  name           String           @db.VarChar(150)
  email          String?          @db.VarChar(255)
  phone          String           @db.VarChar(20)
  dateOfBirth    DateTime?        @map("date_of_birth") @db.Date
  gender         Gender?
  parentName     String?          @map("parent_name") @db.VarChar(150)
  parentPhone    String?          @map("parent_phone") @db.VarChar(20)
  address        String?          @db.Text
  city           String?          @db.VarChar(100)
  state          String?          @db.VarChar(100)
  pincode        String?          @db.VarChar(10)
  photoUrl       String?          @map("photo_url") @db.VarChar(500)
  medicalNotes   String?          @map("medical_notes") @db.Text
  joinedAt       DateTime         @default(now()) @map("joined_at")
  isActive       Boolean          @default(true) @map("is_active")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enrollments  Enrollment[]
  attendance   StudentAttendance[]
  progress     StudentProgress[]
  certificates Certificate[]
  invoices     Invoice[]

  @@unique([tenantId, phone])
  @@index([tenantId])
  @@index([name])
  @@map("students")
}

// ═══════════════════════════════════════════════════════════════
// 5. LEAD / CRM FOUNDATION
// ═══════════════════════════════════════════════════════════════

model Lead {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  branchId     String?    @map("branch_id") @db.Uuid
  name         String     @db.VarChar(150)
  email        String?    @db.VarChar(255)
  phone        String     @db.VarChar(20)
  course       String?    @db.VarChar(200)
  source       LeadSource @default(WALK_IN)
  status       LeadStatus @default(NEW)
  notes        String?    @db.Text
  assignedTo   String?    @map("assigned_to") @db.Uuid
  convertedAt  DateTime?  @map("converted_at")
  convertedToStudentId String? @map("converted_to_student_id") @db.Uuid
  nextFollowUp DateTime?  @map("next_follow_up")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch    Branch?        @relation(fields: [branchId], references: [id])
  followups LeadFollowup[]

  @@index([tenantId])
  @@index([status])
  @@index([source])
  @@index([tenantId, phone])
  @@map("leads")
}

model LeadFollowup {
  id          String   @id @default(uuid()) @db.Uuid
  leadId      String   @map("lead_id") @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  notes       String   @db.Text
  outcome     String?  @db.VarChar(100)
  nextDate    DateTime? @map("next_date")
  contactedVia String? @map("contacted_via") @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at")

  lead Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id])

  @@index([leadId])
  @@map("lead_followups")
}

model Enrollment {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  studentId   String           @map("student_id") @db.Uuid
  batchId     String           @map("batch_id") @db.Uuid
  feePlanId   String?          @map("fee_plan_id") @db.Uuid
  status      EnrollmentStatus @default(ACTIVE)
  enrolledAt  DateTime         @default(now()) @map("enrolled_at")
  completedAt DateTime?        @map("completed_at")
  droppedAt   DateTime?        @map("dropped_at")
  remarks     String?          @db.Text
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  batch   Batch    @relation(fields: [batchId], references: [id])
  feePlan FeePlan? @relation(fields: [feePlanId], references: [id])

  @@unique([studentId, batchId])
  @@index([tenantId])
  @@index([status])
  @@map("enrollments")
}

// ═══════════════════════════════════════════════════════════════
// 6. COURSE MANAGEMENT
// ═══════════════════════════════════════════════════════════════

model CourseCategory {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String   @db.VarChar(150)
  slug        String   @db.VarChar(150)
  description String?  @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  courses Course[]

  @@unique([tenantId, slug])
  @@map("course_categories")
}

model Course {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  categoryId  String?  @map("category_id") @db.Uuid
  name        String   @db.VarChar(200)
  code        String?  @db.VarChar(20)
  description String?  @db.Text
  duration    Int?     /// Duration in hours
  level       String?  @db.VarChar(50)
  fee         Decimal? @db.Decimal(10, 2)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category CourseCategory? @relation(fields: [categoryId], references: [id])
  batches  Batch[]
  feePlans FeePlan[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("courses")
}
