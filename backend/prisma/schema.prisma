generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                         String                  @id @default(uuid()) @db.Uuid
  tenantId                   String?                 @map("tenant_id") @db.Uuid
  email                      String                  @unique @db.VarChar(255)
  passwordHash               String                  @map("password_hash") @db.VarChar(255)
  passwordSet                Boolean                 @default(false) @map("password_set")
  name                       String                  @db.VarChar(150)
  phone                      String?                 @unique @db.VarChar(20)
  role                       UserRole                @default(STAFF)
  status                     UserStatus              @default(PENDING)
  verificationToken          String?                 @unique @map("verification_token") @db.VarChar(255)
  verificationTokenExpiresAt DateTime?               @map("verification_token_expires_at")
  verifiedAt                 DateTime?               @map("verified_at")
  resetPasswordToken         String?                 @map("reset_password_token") @db.VarChar(255)
  resetPasswordExpiresAt     DateTime?               @map("reset_password_expires_at")
  avatarUrl                  String?                 @map("avatar_url") @db.VarChar(500)
  lastLoginAt                DateTime?               @map("last_login_at")
  preferences                Json?                   @default("{}")
  createdAt                  DateTime                @default(now()) @map("created_at")
  updatedAt                  DateTime                @updatedAt @map("updated_at")
  activityLogs               ActivityLog[]
  auditLogs                  AuditLog[]
  authProviders              AuthProvider[]
  batchTrainers              BatchTrainer[]
  leadFollowups              LeadFollowup[]
  notifications              Notification[]
  onboarding                 OnboardingProgress?
  refreshTokens              RefreshToken[]
  securityEvents             SecurityEvent[]
  sessions                   Session[]
  staffMappings              StaffBranchMapping[]
  studentProgress            StudentProgress[]
  gradedSubmissions          StudentTaskSubmission[] @relation("SubmissionGradedBy")
  createdTasks               Task[]                  @relation("UserCreatedTask")
  reviewedRequests           TenantAccessRequest[]   @relation("reviewer")
  accessRequests             TenantAccessRequest[]
  userBranches               UserBranch[]
  devices                    UserDevice[]
  loginLogs                  UserLoginLog[]
  profile                    UserProfile?
  userRoles                  UserRoleMapping[]
  tenant                     Tenant?                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([email])
  @@index([phone])
  @@index([role])
  @@index([status])
  @@index([resetPasswordToken])
  @@map("users")
}

model UserProfile {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @unique @map("user_id") @db.Uuid
  dateOfBirth    DateTime? @map("date_of_birth") @db.Date
  gender         Gender?
  addressLine1   String?   @map("address_line_1") @db.VarChar(255)
  addressLine2   String?   @map("address_line_2") @db.VarChar(255)
  city           String?   @db.VarChar(100)
  state          String?   @db.VarChar(100)
  pincode        String?   @db.VarChar(10)
  emergencyName  String?   @map("emergency_name") @db.VarChar(150)
  emergencyPhone String?   @map("emergency_phone") @db.VarChar(20)
  bio            String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model UserBranch {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@map("user_branches")
}

model UserLoginLog {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  ipAddress    String?  @map("ip_address") @db.VarChar(45)
  userAgent    String?  @map("user_agent") @db.VarChar(500)
  accessToken  String?  @map("access_token")
  refreshToken String?  @map("refresh_token")
  loginAt      DateTime @default(now()) @map("login_at")
  success      Boolean  @default(true)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([loginAt])
  @@index([ipAddress])
  @@map("user_login_log")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  token     String    @unique @db.VarChar(500)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model AuthProvider {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  provider   AuthProviderType
  providerId String?          @map("provider_id") @db.VarChar(255)
  email      String?          @db.VarChar(255)
  linkedAt   DateTime         @default(now()) @map("linked_at")
  createdAt  DateTime         @default(now()) @map("created_at")
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([provider, providerId])
  @@map("auth_providers")
}

model AuthErrorLog {
  id           String   @id @default(uuid()) @db.Uuid
  errorCode    String   @map("error_code") @db.VarChar(100)
  errorMessage String   @map("error_message")
  provider     String?  @db.VarChar(50)
  userId       String?  @map("user_id") @db.Uuid
  timestamp    DateTime @default(now())
  metadata     Json?

  @@map("auth_error_logs")
}

model TenantModule {
  id        String       @id @default(uuid()) @db.Uuid
  tenantId  String       @map("tenant_id") @db.Uuid
  module    IndustryType
  isEnabled Boolean      @default(false) @map("is_enabled")
  enabledAt DateTime?    @map("enabled_at")
  createdAt DateTime     @default(now()) @map("created_at")
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, module])
  @@map("tenant_modules")
}

model TenantAccessRequest {
  id                String              @id @default(uuid()) @db.Uuid
  tenantId          String?             @map("tenant_id") @db.Uuid
  branchId          String?             @map("branch_id") @db.Uuid
  userId            String              @map("user_id") @db.Uuid
  role              UserRole
  status            AccessRequestStatus @default(PENDING)
  notes             String?
  preferredBranchId String?             @map("preferred_branch_id") @db.Uuid
  skills            String[]            @db.VarChar(100)
  specialization    String?             @map("specialization") @db.VarChar(200)
  courseId          String?             @map("course_id") @db.Uuid
  reviewedBy        String?             @map("reviewed_by") @db.Uuid
  reviewedAt        DateTime?           @map("reviewed_at")
  rejectionReason   String?             @map("rejection_reason")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  branch            Branch?             @relation(fields: [branchId], references: [id])
  reviewer          User?               @relation("reviewer", fields: [reviewedBy], references: [id])
  tenant            Tenant?             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([status])
  @@map("tenant_access_requests")
}

model StaffBranchMapping {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  branchId  String?  @map("branch_id") @db.Uuid
  tenantId  String?  @map("tenant_id") @db.Uuid
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")
  branch    Branch?  @relation(fields: [branchId], references: [id])
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@map("staff_branch_mappings")
}

model OnboardingProgress {
  id           String         @id @default(uuid()) @db.Uuid
  userId       String         @unique @map("user_id") @db.Uuid
  selectedRole UserRole?
  currentStep  OnboardingStep @default(ROLE_SELECTION)
  isCompleted  Boolean        @default(false) @map("is_completed")
  completedAt  DateTime?      @map("completed_at")
  metadata     Json?
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("onboarding_progress")
}

model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  module          String           @db.VarChar(100)
  action          String           @db.VarChar(100)
  description     String?          @db.VarChar(255)
  createdAt       DateTime         @default(now()) @map("created_at")
  rolePermissions RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  role         UserRole
  permissionId String     @map("permission_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
  @@map("role_permissions")
}

model UserRoleMapping {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      UserRole
  tenantId  String?  @map("tenant_id") @db.Uuid
  grantedAt DateTime @default(now()) @map("granted_at")
  grantedBy String?  @map("granted_by") @db.Uuid
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role, tenantId])
  @@map("user_roles")
}

model Tenant {
    address          String
  id                 String                @id @default(uuid()) @db.Uuid
  name               String                @unique @db.VarChar(200)
  slug               String                @unique @db.VarChar(100)
  industry           IndustryType          @default(TRAINING)
  status             TenantStatus          @default(TRIAL)
  logoUrl            String?               @map("logo_url") @db.VarChar(500)
  website            String?               @db.VarChar(255)
  phone              String?               @db.VarChar(20)
  email              String?               @db.VarChar(255)
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")
  analyticsSnapshots AnalyticsSnapshot[]
  attendanceSessions AttendanceSession[]
  batches            Batch[]
  branches           Branch[]
  certTemplates      CertificateTemplate[]
  certificates       Certificate[]
  competitions       Competition[]
  courseCategories   CourseCategory[]
  courses            Course[]
  dashboardWidgets   DashboardWidget[]
  enrollments        Enrollment[]
  expenseCategories  ExpenseCategory[]
  feePlans           FeePlan[]
  invoices           Invoice[]
  leads              Lead[]
  notifications      Notification[]
  securityEvents     SecurityEvent[]
  staffMappings      StaffBranchMapping[]
  studentProgress    StudentProgress[]
  students           Student[]
  subscriptionUsage  SubscriptionUsage[]
  subscriptions      Subscription[]
  tasks              Task[]
  accessRequests     TenantAccessRequest[]
  brand              TenantBrand?
  invitations        TenantInvitation[]
  tenantModules      TenantModule[]
  settings           TenantSetting[]
  transactions       Transaction[]
  userRoles          UserRoleMapping[]
  users              User[]

  @@index([slug])
  @@index([status])
  @@map("tenants")
}

model TenantBrand {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @unique @map("tenant_id") @db.Uuid
  primaryColor   String?  @map("primary_color") @db.VarChar(7)
  secondaryColor String?  @map("secondary_color") @db.VarChar(7)
  faviconUrl     String?  @map("favicon_url") @db.VarChar(500)
  tagline        String?  @db.VarChar(255)
  customDomain   String?  @map("custom_domain") @db.VarChar(255)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_brands")
}

model TenantInvitation {
  id        String           @id @default(uuid()) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  email     String           @db.VarChar(255)
  role      UserRole         @default(STAFF)
  token     String           @unique @db.VarChar(255)
  status    InvitationStatus @default(PENDING)
  expiresAt DateTime         @map("expires_at")
  invitedBy String?          @map("invited_by") @db.Uuid
  createdAt DateTime         @default(now()) @map("created_at")
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([tenantId, email])
  @@map("tenant_invitations")
}

model TenantSetting {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String   @db.VarChar(100)
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@map("tenant_settings")
}

model Branch {
  id                 String                @id @default(uuid()) @db.Uuid
  tenantId           String                @map("tenant_id") @db.Uuid
  name               String                @db.VarChar(200)
  code               String?               @db.VarChar(20)
  address            String?
  city               String?               @db.VarChar(100)
  state              String?               @db.VarChar(100)
  pincode            String?               @db.VarChar(10)
  phone              String?               @db.VarChar(20)
  email              String?               @db.VarChar(255)
  isDefault          Boolean               @default(false) @map("is_default")
  isActive           Boolean               @default(true) @map("is_active")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")
  attendanceSessions AttendanceSession[]
  batches            Batch[]
  tenant             Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices           Invoice[]
  leads              Lead[]
  staffMappings      StaffBranchMapping[]
  accessRequests     TenantAccessRequest[]
  userBranches       UserBranch[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("branches")
}

model Plan {
  id            String               @id @default(uuid()) @db.Uuid
  name          String               @db.VarChar(100)
  slug          String               @unique @db.VarChar(100)
  description   String?
  interval      PlanInterval         @default(MONTHLY)
  price         Decimal              @db.Decimal(10, 2)
  currency      String               @default("INR") @db.VarChar(3)
  trialDays     Int                  @default(15) @map("trial_days")
  maxUsers      Int?                 @map("max_users")
  maxBranches   Int?                 @map("max_branches")
  maxStudents   Int?                 @map("max_students")
  isActive      Boolean              @default(true) @map("is_active")
  sortOrder     Int                  @default(0) @map("sort_order")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")
  features      PlanFeature[]
  modules       SubscriptionModule[]
  subscriptions Subscription[]

  @@map("plans")
}

model PlanFeature {
  id        String  @id @default(uuid()) @db.Uuid
  planId    String  @map("plan_id") @db.Uuid
  feature   String  @db.VarChar(200)
  value     String? @db.VarChar(100)
  isEnabled Boolean @default(true) @map("is_enabled")
  plan      Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, feature])
  @@map("plan_features")
}

model SubscriptionModule {
  id       String  @id @default(uuid()) @db.Uuid
  planId   String  @map("plan_id") @db.Uuid
  module   String  @db.VarChar(50)
  isActive Boolean @default(true) @map("is_active")
  plan     Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, module])
  @@map("subscription_modules")
}

model Subscription {
  id          String                @id @default(uuid()) @db.Uuid
  tenantId    String                @map("tenant_id") @db.Uuid
  planId      String                @map("plan_id") @db.Uuid
  status      SubscriptionStatus    @default(TRIAL)
  startDate   DateTime              @map("start_date") @db.Date
  endDate     DateTime              @map("end_date") @db.Date
  trialEndsAt DateTime?             @map("trial_ends_at")
  cancelledAt DateTime?             @map("cancelled_at")
  autoRenew   Boolean               @default(true) @map("auto_renew")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")
  history     SubscriptionHistory[]
  invoices    SubscriptionInvoice[]
  payments    SubscriptionPayment[]
  usage       SubscriptionUsage[]
  plan        Plan                  @relation(fields: [planId], references: [id])
  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@map("subscriptions")
}

model SubscriptionUsage {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  subscriptionId String       @map("subscription_id") @db.Uuid
  metric         String       @db.VarChar(100)
  currentValue   Int          @default(0) @map("current_value")
  maxValue       Int?         @map("max_value")
  periodStart    DateTime     @map("period_start") @db.Date
  periodEnd      DateTime     @map("period_end") @db.Date
  updatedAt      DateTime     @updatedAt @map("updated_at")
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, metric, periodStart])
  @@map("subscription_usage")
}

model SubscriptionInvoice {
  id             String                @id @default(uuid()) @db.Uuid
  subscriptionId String                @map("subscription_id") @db.Uuid
  invoiceNumber  String                @unique @map("invoice_number") @db.VarChar(50)
  amount         Decimal               @db.Decimal(10, 2)
  tax            Decimal               @default(0) @db.Decimal(10, 2)
  totalAmount    Decimal               @map("total_amount") @db.Decimal(10, 2)
  currency       String                @default("INR") @db.VarChar(3)
  status         InvoiceStatus         @default(DRAFT)
  dueDate        DateTime              @map("due_date") @db.Date
  paidAt         DateTime?             @map("paid_at")
  pdfUrl         String?               @map("pdf_url") @db.VarChar(500)
  createdAt      DateTime              @default(now()) @map("created_at")
  subscription   Subscription          @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  payments       SubscriptionPayment[]

  @@index([subscriptionId])
  @@map("subscription_invoices")
}

model SubscriptionPayment {
  id              String               @id @default(uuid()) @db.Uuid
  subscriptionId  String               @map("subscription_id") @db.Uuid
  invoiceId       String?              @map("invoice_id") @db.Uuid
  amount          Decimal              @db.Decimal(10, 2)
  currency        String               @default("INR") @db.VarChar(3)
  mode            PaymentMode          @default(ONLINE)
  status          PaymentStatus        @default(PENDING)
  gatewayRef      String?              @map("gateway_ref") @db.VarChar(255)
  gatewayResponse Json?                @map("gateway_response")
  paidAt          DateTime?            @map("paid_at")
  createdAt       DateTime             @default(now()) @map("created_at")
  invoice         SubscriptionInvoice? @relation(fields: [invoiceId], references: [id])
  subscription    Subscription         @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@map("subscription_payments")
}

model SubscriptionHistory {
  id             String              @id @default(uuid()) @db.Uuid
  subscriptionId String              @map("subscription_id") @db.Uuid
  action         String              @db.VarChar(50)
  previousStatus SubscriptionStatus? @map("previous_status")
  newStatus      SubscriptionStatus? @map("new_status")
  metadata       Json?
  createdAt      DateTime            @default(now()) @map("created_at")
  subscription   Subscription        @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@map("subscription_history")
}

model ModuleInterest {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @db.VarChar(255)
  name      String?  @db.VarChar(150)
  phone     String?  @db.VarChar(20)
  modules   String[] @db.VarChar(50)
  message   String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("modules_interest")
}

model Student {
  id              String                  @id @default(uuid()) @db.Uuid
  tenantId        String                  @map("tenant_id") @db.Uuid
  registrationNo  String?                 @unique @map("registration_no") @db.VarChar(50)
  name            String                  @db.VarChar(150)
  email           String?                 @db.VarChar(255)
  phone           String                  @db.VarChar(20)
  dateOfBirth     DateTime?               @map("date_of_birth") @db.Date
  gender          Gender?
  parentName      String?                 @map("parent_name") @db.VarChar(150)
  parentPhone     String?                 @map("parent_phone") @db.VarChar(20)
  address         String?
  city            String?                 @db.VarChar(100)
  state           String?                 @db.VarChar(100)
  pincode         String?                 @db.VarChar(10)
  photoUrl        String?                 @map("photo_url") @db.VarChar(500)
  medicalNotes    String?                 @map("medical_notes")
  joinedAt        DateTime                @default(now()) @map("joined_at")
  isActive        Boolean                 @default(true) @map("is_active")
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")
  certificates    Certificate[]
  enrollments     Enrollment[]
  invoices        Invoice[]
  attendance      StudentAttendance[]
  progress        StudentProgress[]
  taskSubmissions StudentTaskSubmission[]
  tenant          Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, phone])
  @@index([tenantId])
  @@index([name])
  @@map("students")
}

model Lead {
  id                   String         @id @default(uuid()) @db.Uuid
  tenantId             String         @map("tenant_id") @db.Uuid
  branchId             String?        @map("branch_id") @db.Uuid
  name                 String         @db.VarChar(150)
  email                String?        @db.VarChar(255)
  phone                String         @db.VarChar(20)
  course               String?        @db.VarChar(200)
  source               LeadSource     @default(WALK_IN)
  status               LeadStatus     @default(NEW)
  notes                String?
  assignedTo           String?        @map("assigned_to") @db.Uuid
  convertedAt          DateTime?      @map("converted_at")
  convertedToStudentId String?        @map("converted_to_student_id") @db.Uuid
  nextFollowUp         DateTime?      @map("next_follow_up")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")
  followups            LeadFollowup[]
  branch               Branch?        @relation(fields: [branchId], references: [id])
  tenant               Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@index([source])
  @@index([tenantId, phone])
  @@map("leads")
}

model LeadFollowup {
  id           String    @id @default(uuid()) @db.Uuid
  leadId       String    @map("lead_id") @db.Uuid
  userId       String?   @map("user_id") @db.Uuid
  notes        String
  outcome      String?   @db.VarChar(100)
  nextDate     DateTime? @map("next_date")
  contactedVia String?   @map("contacted_via") @db.VarChar(50)
