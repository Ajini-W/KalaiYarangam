  @@index([batchId, date])
  @@map("class_sessions")
}

model StudentProgress {
  id         String   @id @default(uuid()) @db.Uuid
  studentId  String   @map("student_id") @db.Uuid
  batchId    String?  @map("batch_id") @db.Uuid
  trainerId  String?  @map("trainer_id") @db.Uuid
