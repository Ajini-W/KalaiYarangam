// ─────────────────────────────────────────────────────────────
// KalaiArangam — Multi-Tenant SaaS ERP
// Module: Class & Training Management (MVP)
// Database: PostgreSQL via Prisma ORM
// ─────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ═══════════════════════════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════════════════════════

enum UserRole {
  SUPER_ADMIN
  OWNER
  BRANCH_MANAGER
  TRAINER
  STAFF
  STUDENT
  CLIENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum TenantStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  TRIAL
}

enum IndustryType {
  TRAINING
  RENTAL
  EVENT
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum PlanInterval {
  MONTHLY
  HALF_YEARLY
  YEARLY
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentMode {
  ONLINE
  CASH
  BANK_TRANSFER
  UPI
  CHEQUE
}

enum LeadStatus {
  NEW
  CONTACTED
  FOLLOWUP
  INTERESTED
  DEMO_SCHEDULED
  CONVERTED
  LOST
}

enum LeadSource {
  WALK_IN
  PHONE
  WEBSITE
  SOCIAL_MEDIA
  REFERRAL
  ADVERTISEMENT
  OTHER
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  DROPPED
  SUSPENDED
  TRANSFERRED
}

enum BatchStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum SessionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum FeeType {
  ONE_TIME
  MONTHLY
  QUARTERLY
  TERM
  YEARLY
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  PARTIALLY_PAID
  OVERDUE
  CANCELLED
  REFUNDED
}

enum TransactionType {
  INCOME
  EXPENSE
  REFUND
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  IN_APP
  PUSH
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
  IMPORT
}

enum HealthStatus {
  HEALTHY
  AT_RISK
  CRITICAL
  CHURNED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}
// ═══════════════════════════════════════════════════════════════
// 1. AUTHENTICATION & USER MANAGEMENT
// ═══════════════════════════════════════════════════════════════

model User {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String?    @map("tenant_id") @db.Uuid
  email        String     @db.VarChar(255)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  name         String     @db.VarChar(150)
  phone        String?    @db.VarChar(20)
  role         UserRole   @default(STAFF)
  status       UserStatus @default(PENDING)
  avatarUrl       String?    @map("avatar_url") @db.VarChar(500)
  emailVerifiedAt DateTime?  @map("email_verified_at")
  lastLoginAt     DateTime?  @map("last_login_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  tenant          Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  profile         UserProfile?
  userBranches    UserBranch[]
  loginLogs       UserLoginLog[]
  refreshTokens   RefreshToken[]
  userRoles       UserRoleMapping[]
  leadFollowups   LeadFollowup[]
  batchTrainers   BatchTrainer[]
  studentProgress StudentProgress[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  activityLogs    ActivityLog[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([email])
  @@index([role])
  @@index([status])
  @@map("users")
}

model UserProfile {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @unique @map("user_id") @db.Uuid
  dateOfBirth   DateTime? @map("date_of_birth") @db.Date
  gender        Gender?
  addressLine1  String?   @map("address_line_1") @db.VarChar(255)
  addressLine2  String?   @map("address_line_2") @db.VarChar(255)
  city          String?   @db.VarChar(100)
  state         String?   @db.VarChar(100)
  pincode       String?   @db.VarChar(10)
  emergencyName String?   @map("emergency_name") @db.VarChar(150)
  emergencyPhone String?  @map("emergency_phone") @db.VarChar(20)
  bio           String?   @db.Text
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model UserBranch {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@map("user_branches")
}

model UserLoginLog {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  ipAddress    String?  @map("ip_address") @db.VarChar(45)
  userAgent    String?  @map("user_agent") @db.VarChar(500)
  accessToken  String?  @map("access_token") @db.Text
  refreshToken String?  @map("refresh_token") @db.Text
  loginAt      DateTime @default(now()) @map("login_at")
  success      Boolean  @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([loginAt])
  @@index([ipAddress])
  @@map("user_login_log")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique @db.VarChar(500)
  expiresAt DateTime @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  module      String   @db.VarChar(100)
  action      String   @db.VarChar(100)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  role         UserRole
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
  @@map("role_permissions")
}

model UserRoleMapping {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      UserRole
  tenantId  String?  @map("tenant_id") @db.Uuid
  grantedAt DateTime @default(now()) @map("granted_at")
  grantedBy String?  @map("granted_by") @db.Uuid

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, role, tenantId])
  @@map("user_roles")
}

// ═══════════════════════════════════════════════════════════════
// 2. PLATFORM / MULTI-TENANT
// ═══════════════════════════════════════════════════════════════

model Tenant {
  id        String       @id @default(uuid()) @db.Uuid
  name      String       @db.VarChar(200)
  slug      String       @unique @db.VarChar(100)
  industry  IndustryType @default(TRAINING)
  status    TenantStatus @default(TRIAL)
  logoUrl   String?      @map("logo_url") @db.VarChar(500)
  website   String?      @db.VarChar(255)
  phone     String?      @db.VarChar(20)
  email     String?      @db.VarChar(255)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  users             User[]
  userRoles         UserRoleMapping[]
  brand             TenantBrand?
  invitations       TenantInvitation[]
  settings          TenantSetting[]
  branches          Branch[]
  subscriptions     Subscription[]
  subscriptionUsage SubscriptionUsage[]
  students          Student[]
  leads             Lead[]
  enrollments       Enrollment[]
  courses           Course[]
  courseCategories   CourseCategory[]
  batches           Batch[]
  competitions      Competition[]
  attendanceSessions AttendanceSession[]
  feePlans          FeePlan[]
  invoices          Invoice[]
  expenseCategories ExpenseCategory[]
  transactions      Transaction[]
  certTemplates     CertificateTemplate[]
  certificates      Certificate[]
  dashboardWidgets  DashboardWidget[]
  analyticsSnapshots AnalyticsSnapshot[]
  notifications     Notification[]

  @@index([slug])
  @@index([status])
  @@map("tenants")
}

model TenantBrand {
  id             String  @id @default(uuid()) @db.Uuid
  tenantId       String  @unique @map("tenant_id") @db.Uuid
  primaryColor   String? @map("primary_color") @db.VarChar(7)
  secondaryColor String? @map("secondary_color") @db.VarChar(7)
  faviconUrl     String? @map("favicon_url") @db.VarChar(500)
  tagline        String? @db.VarChar(255)
  customDomain   String? @map("custom_domain") @db.VarChar(255)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_brands")
}

model TenantInvitation {
  id        String           @id @default(uuid()) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  email     String           @db.VarChar(255)
  role      UserRole         @default(STAFF)
  token     String           @unique @db.VarChar(255)
  status    InvitationStatus @default(PENDING)
  expiresAt DateTime         @map("expires_at")
  invitedBy String?          @map("invited_by") @db.Uuid
  createdAt DateTime         @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([tenantId, email])
  @@map("tenant_invitations")
}

model TenantSetting {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String   @db.VarChar(100)
  value     String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@map("tenant_settings")
}

model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String   @db.VarChar(200)
  code      String?  @db.VarChar(20)
  address   String?  @db.Text
  city      String?  @db.VarChar(100)
  state     String?  @db.VarChar(100)
  pincode   String?  @db.VarChar(10)
  phone     String?  @db.VarChar(20)
  email     String?  @db.VarChar(255)
  isDefault Boolean  @default(false) @map("is_default")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userBranches     UserBranch[]
  leads            Lead[]
  batches          Batch[]
  attendanceSessions AttendanceSession[]
  invoices         Invoice[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("branches")
}
// ═══════════════════════════════════════════════════════════════
// 3. SUBSCRIPTION & BILLING (SaaS)
// ═══════════════════════════════════════════════════════════════

model Plan {
  id            String       @id @default(uuid()) @db.Uuid
  name          String       @db.VarChar(100)
  slug          String       @unique @db.VarChar(100)
  description   String?      @db.Text
  interval      PlanInterval @default(MONTHLY)
  price         Decimal      @db.Decimal(10, 2)
  currency      String       @default("INR") @db.VarChar(3)
  trialDays     Int          @default(15) @map("trial_days")
  maxUsers      Int?         @map("max_users")
  maxBranches   Int?         @map("max_branches")
  maxStudents   Int?         @map("max_students")
  isActive      Boolean      @default(true) @map("is_active")
  sortOrder     Int          @default(0) @map("sort_order")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  features      PlanFeature[]
  subscriptions Subscription[]
  modules       SubscriptionModule[]

  @@map("plans")
}

model PlanFeature {
  id        String  @id @default(uuid()) @db.Uuid
  planId    String  @map("plan_id") @db.Uuid
  feature   String  @db.VarChar(200)
  value     String? @db.VarChar(100)
  isEnabled Boolean @default(true) @map("is_enabled")

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, feature])
  @@map("plan_features")
}

model SubscriptionModule {
  id       String @id @default(uuid()) @db.Uuid
  planId   String @map("plan_id") @db.Uuid
  module   String @db.VarChar(50)
  isActive Boolean @default(true) @map("is_active")

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, module])
  @@map("subscription_modules")
}

model Subscription {
  id           String             @id @default(uuid()) @db.Uuid
  tenantId     String             @map("tenant_id") @db.Uuid
  planId       String             @map("plan_id") @db.Uuid
  status       SubscriptionStatus @default(TRIAL)
  startDate    DateTime           @map("start_date") @db.Date
  endDate      DateTime           @map("end_date") @db.Date
  trialEndsAt  DateTime?          @map("trial_ends_at")
  cancelledAt  DateTime?          @map("cancelled_at")
  autoRenew    Boolean            @default(true) @map("auto_renew")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  tenant   Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan     Plan                 @relation(fields: [planId], references: [id])
  usage    SubscriptionUsage[]
  invoices SubscriptionInvoice[]
  payments SubscriptionPayment[]
  history  SubscriptionHistory[]

  @@index([tenantId])
  @@index([status])
  @@map("subscriptions")
}

model SubscriptionUsage {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  subscriptionId String   @map("subscription_id") @db.Uuid
  metric         String   @db.VarChar(100)
  currentValue   Int      @default(0) @map("current_value")
  maxValue       Int?     @map("max_value")
  periodStart    DateTime @map("period_start") @db.Date
  periodEnd      DateTime @map("period_end") @db.Date
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, metric, periodStart])
  @@map("subscription_usage")
}

model SubscriptionInvoice {
  id             String        @id @default(uuid()) @db.Uuid
  subscriptionId String        @map("subscription_id") @db.Uuid
  invoiceNumber  String        @unique @map("invoice_number") @db.VarChar(50)
  amount         Decimal       @db.Decimal(10, 2)
  tax            Decimal       @default(0) @db.Decimal(10, 2)
  totalAmount    Decimal       @map("total_amount") @db.Decimal(10, 2)
  currency       String        @default("INR") @db.VarChar(3)
  status         InvoiceStatus @default(DRAFT)
  dueDate        DateTime      @map("due_date") @db.Date
  paidAt         DateTime?     @map("paid_at")
  pdfUrl         String?       @map("pdf_url") @db.VarChar(500)
  createdAt      DateTime      @default(now()) @map("created_at")

  subscription Subscription          @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  payments     SubscriptionPayment[]

  @@index([subscriptionId])
  @@map("subscription_invoices")
}

model SubscriptionPayment {
  id             String        @id @default(uuid()) @db.Uuid
  subscriptionId String        @map("subscription_id") @db.Uuid
  invoiceId      String?       @map("invoice_id") @db.Uuid
  amount         Decimal       @db.Decimal(10, 2)
  currency       String        @default("INR") @db.VarChar(3)
  mode           PaymentMode   @default(ONLINE)
  status         PaymentStatus @default(PENDING)
  gatewayRef     String?       @map("gateway_ref") @db.VarChar(255)
  gatewayResponse Json?        @map("gateway_response")
  paidAt         DateTime?     @map("paid_at")
  createdAt      DateTime      @default(now()) @map("created_at")

  subscription Subscription         @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  invoice      SubscriptionInvoice? @relation(fields: [invoiceId], references: [id])

  @@index([subscriptionId])
  @@map("subscription_payments")
}

model SubscriptionHistory {
  id             String             @id @default(uuid()) @db.Uuid
  subscriptionId String             @map("subscription_id") @db.Uuid
  action         String             @db.VarChar(50)
  previousStatus SubscriptionStatus? @map("previous_status")
  newStatus      SubscriptionStatus? @map("new_status")
  metadata       Json?
  createdAt      DateTime           @default(now()) @map("created_at")

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@map("subscription_history")
}

model ModuleInterest {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @db.VarChar(255)
  name      String?  @db.VarChar(150)
  phone     String?  @db.VarChar(20)
  modules   String[] @db.VarChar(50)
  message   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@map("modules_interest")
}
// ═══════════════════════════════════════════════════════════════
// 4. STUDENT MANAGEMENT
// ═══════════════════════════════════════════════════════════════

model Student {
  id             String           @id @default(uuid()) @db.Uuid
  tenantId       String           @map("tenant_id") @db.Uuid
  registrationNo String?         @unique @map("registration_no") @db.VarChar(50)
  name           String           @db.VarChar(150)
  email          String?          @db.VarChar(255)
  phone          String           @db.VarChar(20)
  dateOfBirth    DateTime?        @map("date_of_birth") @db.Date
  gender         Gender?
  parentName     String?          @map("parent_name") @db.VarChar(150)
  parentPhone    String?          @map("parent_phone") @db.VarChar(20)
  address        String?          @db.Text
  city           String?          @db.VarChar(100)
  state          String?          @db.VarChar(100)
  pincode        String?          @db.VarChar(10)
  photoUrl       String?          @map("photo_url") @db.VarChar(500)
  medicalNotes   String?          @map("medical_notes") @db.Text
  joinedAt       DateTime         @default(now()) @map("joined_at")
  isActive       Boolean          @default(true) @map("is_active")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enrollments  Enrollment[]
  attendance   StudentAttendance[]
  progress     StudentProgress[]
  certificates Certificate[]
  invoices     Invoice[]

  @@unique([tenantId, phone])
  @@index([tenantId])
  @@index([name])
  @@map("students")
}

// ═══════════════════════════════════════════════════════════════
// 5. LEAD / CRM FOUNDATION
// ═══════════════════════════════════════════════════════════════

model Lead {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  branchId     String?    @map("branch_id") @db.Uuid
  name         String     @db.VarChar(150)
  email        String?    @db.VarChar(255)
  phone        String     @db.VarChar(20)
  course       String?    @db.VarChar(200)
  source       LeadSource @default(WALK_IN)
  status       LeadStatus @default(NEW)
  notes        String?    @db.Text
  assignedTo   String?    @map("assigned_to") @db.Uuid
  convertedAt  DateTime?  @map("converted_at")
  convertedToStudentId String? @map("converted_to_student_id") @db.Uuid
  nextFollowUp DateTime?  @map("next_follow_up")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch    Branch?        @relation(fields: [branchId], references: [id])
  followups LeadFollowup[]

  @@index([tenantId])
  @@index([status])
  @@index([source])
  @@index([tenantId, phone])
  @@map("leads")
}

model LeadFollowup {
  id          String   @id @default(uuid()) @db.Uuid
  leadId      String   @map("lead_id") @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  notes       String   @db.Text
  outcome     String?  @db.VarChar(100)
  nextDate    DateTime? @map("next_date")
  contactedVia String? @map("contacted_via") @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at")

  lead Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id])

  @@index([leadId])
  @@map("lead_followups")
}

model Enrollment {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  studentId   String           @map("student_id") @db.Uuid
  batchId     String           @map("batch_id") @db.Uuid
  feePlanId   String?          @map("fee_plan_id") @db.Uuid
  status      EnrollmentStatus @default(ACTIVE)
  enrolledAt  DateTime         @default(now()) @map("enrolled_at")
  completedAt DateTime?        @map("completed_at")
  droppedAt   DateTime?        @map("dropped_at")
  remarks     String?          @db.Text
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  batch   Batch    @relation(fields: [batchId], references: [id])
  feePlan FeePlan? @relation(fields: [feePlanId], references: [id])

