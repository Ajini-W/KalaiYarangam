meta {
  name: Security - Login History
  type: http
  seq: 4
}

get {
  url: {{base-url}}/security/login-history?page=1&pageSize=20
  body: none
  auth: inherit
}

headers {
  Authorization: bearer {{accessToken}}
}

settings {
  encodeUrl: true
  timeout: 0
}

example {
  name: 200

  request: {
    url: {{base-url}}/security/login-history?page=1&pageSize=20
    method: GET
    mode: none
    headers: {
      Authorization: bearer {{accessToken}}
    }
  }

  response: {
    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "httpStatusCode": 200,
          "message": "Login history fetched",
          "data": [
            {
              "id": "uuid-1",
              "userId": "uuid-2",
              "ipAddress": "192.168.1.1",
              "userAgent": "Mozilla/5.0...",
              "accessToken": "eyJ...",
              "refreshToken": "eyJ...",
              "loginAt": "2026-06-24T10:30:00.000Z",
              "success": true,
              "user": {
                "id": "uuid-2",
                "name": "John Doe",
                "email": "john@example.com",
                "role": "STAFF"
              }
            }
          ],
          "meta": {
            "page": 1,
            "pageSize": 20,
            "total": 156,
            "totalPages": 8
          }
        }
      '''
    }
  }
}
