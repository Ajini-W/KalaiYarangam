meta {
  name: Create Security Event
  type: http
  seq: 10
}

post {
  url: {{base-url}}/security/security-events
  body: json
  auth: inherit
}

headers {
  Authorization: bearer {{accessToken}}
}

body:json {
  {
    "eventType": "BRUTE_FORCE_ATTEMPT",
    "severity": "CRITICAL",
    "message": "Multiple failed login attempts detected for user john@example.com",
    "userId": "user-uuid-here",
    "metadata": {
      "attempts": 15,
      "windowMinutes": 5
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

example {
  name: 200
  
  request: {
    url: {{base-url}}/security/security-events
    method: POST
    headers: {
      Authorization: bearer {{accessToken}}
      Content-Type: application/json
    }
    body: {
      type: json
      content: '''
        {
          "eventType": "BRUTE_FORCE_ATTEMPT",
          "severity": "CRITICAL",
          "message": "Multiple failed login attempts detected for user john@example.com",
          "userId": "user-uuid-here",
          "metadata": {
            "attempts": 15,
            "windowMinutes": 5
          }
        }
      '''
    }
  }
  
  response: {
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "httpStatusCode": 201,
          "message": "Security event created",
          "data": null,
          "timestamp": "2026-06-28T10:30:00.000Z"
        }
      '''
    }
  }
}
