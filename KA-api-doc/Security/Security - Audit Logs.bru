meta {
  name: Security - Audit Logs
  type: http
  seq: 5
}

get {
  url: {{base-url}}/security/audit-logs?page=1&pageSize=20
  body: none
  auth: inherit
}

headers {
  Authorization: bearer {{accessToken}}
}

settings {
  encodeUrl: true
  timeout: 0
}

example {
  name: 200

  request: {
    url: {{base-url}}/security/audit-logs?page=1&pageSize=20
    method: GET
    mode: none
    headers: {
      Authorization: bearer {{accessToken}}
    }
  }

  response: {
    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "httpStatusCode": 200,
          "message": "Audit logs fetched",
          "data": [
            {
              "id": "uuid-1",
              "userId": "uuid-2",
              "tenantId": "uuid-3",
              "action": "STATUS_CHANGE",
              "entity": "User",
              "entityId": "uuid-4",
              "oldValues": {"status": "ACTIVE"},
              "newValues": {"status": "SUSPENDED"},
              "ipAddress": "192.168.1.1",
              "userAgent": "Mozilla/5.0...",
              "createdAt": "2026-06-24T10:30:00.000Z",
              "user": {
                "id": "uuid-2",
                "name": "Admin User",
                "email": "admin@example.com",
                "role": "SUPER_ADMIN"
              }
            }
          ],
          "meta": {
            "page": 1,
            "pageSize": 20,
            "total": 1250,
            "totalPages": 63
          }
        }
      '''
    }
  }
}
