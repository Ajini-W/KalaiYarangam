meta {
  name: Activity Logs
  type: http
  seq: 6
}

get {
  url: {{base-url}}/security/activity-logs?page=1&pageSize=20
  body: none
  auth: inherit
}

headers {
  Authorization: bearer {{accessToken}}
}

settings {
  encodeUrl: true
  timeout: 0
}

example {
  name: 200
  
  request: {
    url: {{base-url}}/security/activity-logs?page=1&pageSize=20
    method: GET
    mode: none
    headers: {
      Authorization: bearer {{accessToken}}
    }
  }
  
  response: {
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "httpStatusCode": 200,
          "message": "Activity logs fetched",
          "data": [
            {
              "id": "uuid-1",
              "userId": "uuid-2",
              "tenantId": "uuid-3",
              "activity": "Updated billing address",
              "details": {"field": "address", "old": "123 Main St", "new": "456 Oak Ave"},
              "ipAddress": "192.168.1.1",
              "createdAt": "2026-06-24T10:30:00.000Z",
              "user": {
                "id": "uuid-2",
                "name": "Jane Doe",
                "email": "jane@example.com",
                "role": "OWNER"
              }
            }
          ],
          "meta": {
            "page": 1,
            "pageSize": 20,
            "total": 890,
            "totalPages": 45
          }
        }
      '''
    }
  }
}
