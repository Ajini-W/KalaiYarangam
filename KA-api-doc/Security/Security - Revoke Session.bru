meta {
  name: Security - Revoke Session
  type: http
  seq: 3
}

delete {
  url: {{base-url}}/security/sessions/:id
  body: none
  auth: inherit
}

headers {
  Authorization: bearer {{accessToken}}
}

settings {
  encodeUrl: true
  timeout: 0
}

example {
  name: 200

  request: {
    url: {{base-url}}/security/sessions/session-uuid-here
    method: DELETE
    mode: none
    headers: {
      Authorization: bearer {{accessToken}}
    }
  }

  response: {
    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "httpStatusCode": 200,
          "message": "Session revoked successfully"
        }
      '''
    }
  }
}
