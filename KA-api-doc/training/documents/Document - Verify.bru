meta {
  name: Document - Verify
  type: http
  seq: 5
}

post {
  url: {{base-url}}/training/documents/{{documentId}}/verify
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "status": "VERIFIED",
    "notes": "All details match"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
