meta {
  name: Batch - Get
  type: http
  seq: 4
}

get {
  url: {{base-url}}/training/batches/{{batchId}}
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
}

vars:pre-request {
  batchId: 00000000-0000-0000-0000-000000000000
}

settings {
  encodeUrl: true
  timeout: 0
}
