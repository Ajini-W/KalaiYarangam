meta {
  name: Batch - Create
  type: http
  seq: 1
}

post {
  url: {{base-url}}/training/batches
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "name": "Morning Yoga Batch",
    "code": "MY-001",
    "capacity": 25,
    "startDate": "2026-07-01",
    "endDate": "2026-09-30"
  }
}

script:post-response {
  const body = res.getBody();
  if (body.data) { bru.setVar("batchId", body.data.id); }
}

settings {
  encodeUrl: true
  timeout: 0
}
