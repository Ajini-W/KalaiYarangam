meta {
  name: Schedule - Get
  type: http
  seq: 6
}

get {
  url: {{base-url}}/training/schedules/{{scheduleId}}
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
}

vars:pre-request {
  scheduleId: 00000000-0000-0000-0000-000000000000
}

settings {
  encodeUrl: true
  timeout: 0
}
