meta {
  name: Trainer - Get
  type: http
  seq: 3
}

get {
  url: {{base-url}}/training/trainers/{{trainerId}}
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
}

vars:pre-request {
  trainerId: 00000000-0000-0000-0000-000000000000
}

settings {
  encodeUrl: true
  timeout: 0
}
