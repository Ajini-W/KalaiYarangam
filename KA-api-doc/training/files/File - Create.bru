meta {
  name: File - Create
  type: http
  seq: 1
}

post {
  url: {{base-url}}/training/files
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "originalName": "sample.pdf",
    "mimeType": "application/pdf",
    "size": 102400,
    "category": "TRAINING_MATERIAL"
  }
}

script:post-response {
  const body = res.getBody();
  if (body.data) { bru.setVar("fileId", body.data.id); }
}

settings {
  encodeUrl: true
  timeout: 0
}
