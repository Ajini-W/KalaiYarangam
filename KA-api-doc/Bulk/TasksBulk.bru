meta {
  name: Tasks Bulk
  type: http
  seq: 4
}

post {
  url: {{base-url}}/bulk/tasks
  body: json
  auth: inherit
}

headers {
  Authorization: bearer {{accessToken}}
  Content-Type: application/json
}

body:json {
  {
    "batchId": "0dc78def-8e0b-4747-b77a-1923a999eaf0",
    "tasks": [
      {
        "title": "Math Homework",
        "description": "Complete chapter 5 exercises",
        "type": "HOMEWORK",
        "dueDate": "2026-07-07T00:00:00.000Z",
        "maxScore": 100,
        "allowLateSubmission": "true"
      }
    ]
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
