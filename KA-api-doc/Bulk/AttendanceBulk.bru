        "studentId": "e30dfb75-0b0b-47f7-8ec2-627975dfce53",
        "status": "PRESENT",
        "remarks": "On time",
        "checkInTime": "09:00 AM"
      }
    ]
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
