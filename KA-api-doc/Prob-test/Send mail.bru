meta {
  name: Send mail
  type: http
  seq: 1
}

post {
  url: {{base-url}}/mail/send
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "to": "@gmail.com",
    "template": "welcome",
    "variables": {
      "name": "Abishek",
      "email": "@gmail.com"
    }
  }
}
