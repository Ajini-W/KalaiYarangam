meta {
  name: Login
  type: http
  seq: 4
}

post {
  url: {{base-url}}/auth/login
  body: json
  auth: inherit

  {
    "type": "email",
    "email": "user@example.com",
    "password": "password123",
    "rememberMe": false
  }
}

script:after-response {
  bru.setVar('authToken', res.body.data.accessToken);
}
