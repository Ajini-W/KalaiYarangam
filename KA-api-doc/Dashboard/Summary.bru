meta {
  name: Summary
  type: http
  seq: 1
}

get {
  url: {{base-url}}/dashboard/summary
  body: none
  auth: inherit
}

headers {
  Authorization: bearer {{accessToken}}
}

settings {
  encodeUrl: true
  timeout: 0
}

example {
  name: 200

  request: {
    url: {{base-url}}/dashboard/summary
    method: GET
    mode: none
    headers: {
      Authorization: bearer {{accessToken}}
    }
  }

  response: {
    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "httpStatusCode": 200,
          "message": "Dashboard overview retrieved successfully",
          "data": {
            "totalStudents": 45,
            "activeBranches": 3,
            "revenueMTD": 125000.00,
            "pendingPayments": 12,
            "activeBatches": 8,
            "totalEnrollments": 40
          },
          "timestamp": "2026-06-29T13:00:00.000Z"
        }
      '''
    }
  }
}
