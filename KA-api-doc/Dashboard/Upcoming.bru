meta {
  name: Upcoming
  type: http
  seq: 3
}

get {
  url: {{base-url}}/dashboard/upcoming
  body: none
  auth: inherit
}

headers {
  Authorization: bearer {{accessToken}}
}

settings {
  encodeUrl: true
  timeout: 0
}

example {
  name: 200

  request: {
    url: {{base-url}}/dashboard/upcoming
    method: GET
    mode: none
    headers: {
      Authorization: bearer {{accessToken}}
    }
  }

  response: {
    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "httpStatusCode": 200,
          "message": "Upcoming events retrieved successfully",
          "data": {
            "sessions": [
              {
                "id": "uuid-1",
                "date": "2026-06-30",
                "startTime": "09:00",
                "endTime": "11:00",
                "topic": "Algebra Basics",
                "status": "SCHEDULED",
                "batch": { "id": "uuid-b1", "name": "Batch A" },
                "attendanceSession": null
              }
            ],
            "tasks": [
              {
                "id": "uuid-t1",
                "title": "Homework 3",
                "type": "HOMEWORK",
                "status": "PENDING",
                "dueDate": "2026-07-02",
                "batch": { "id": "uuid-b1", "name": "Batch A" }
              }
            ],
            "followups": [
              {
                "id": "uuid-f1",
                "name": "John Doe",
                "phone": "9876543210",
                "course": "Mathematics",
                "status": "INTERESTED",
                "nextFollowUp": "2026-07-01T10:00:00.000Z"
              }
            ]
          },
          "timestamp": "2026-06-29T13:00:00.000Z"
        }
      '''
    }
  }
}
