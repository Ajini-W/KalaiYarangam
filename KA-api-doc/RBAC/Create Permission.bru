meta {
  name: Create Permission
  type: http
  seq: 2
}

post {
  url: {{base-url}}/rbac/permissions
  body: json
  auth: inherit
}

headers {
  Authorization: bearer {{accessToken}}
}

body:json {
  {
    "module": "users",
    "action": "create",
    "description": "Allows creating new users"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
