meta {
  name: Update Permission
  type: http
  seq: 3
}

put {
  url: {{base-url}}/rbac/permissions/{{permissionId}}
  body: json
  auth: inherit
}

headers {
  Authorization: bearer {{accessToken}}
}

body:json {
  {
    "module": "users",
    "action": "create",
    "description": "Allows creating new user accounts"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
