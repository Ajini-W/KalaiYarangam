meta {
  name: Assign User Role
  type: http
  seq: 8
}

post {
  url: {{base-url}}/rbac/user-roles
  body: json
  auth: inherit
}

headers {
  Authorization: bearer {{accessToken}}
}

body:json {
  {
    "userId": "user-uuid",
    "role": "TRAINER"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
