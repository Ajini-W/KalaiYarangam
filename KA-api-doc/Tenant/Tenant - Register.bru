meta {
  name: Tenant - Register
  type: http
  seq: 1
}

post {
  url: {{base-url}}/auth/register
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Tenant01 Academy",
    "email": "tenant@gmail.com",
    "phone": "9787217678",
    "password": "Demo@123"
  }
}

vars:post-response {
  token: data.accessToken
}

script:post-response {
  const body = res.getBody();
  bru.setVar("token", body.data.accessToken);
}

settings {
  encodeUrl: true
  timeout: 0
}
