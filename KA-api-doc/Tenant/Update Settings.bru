meta {
  name: Update Settings
  type: http
  seq: 10
}

patch {
  url: {{base-url}}/training/settings
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "timezone": "Asia/Kolkata",
    "dateFormat": "DD/MM/YYYY",
    "currency": "INR",
    "language": "en",
    "timeFormat": "12h",
    "weekStartDay": "monday"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
