meta {
  name: Tenant - Create Student
  type: http
  seq: 17
}

post {
  url: {{base-url}}/training/students
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "name": "Rajesh Kumar",
    "phone": "9876543210",
    "email": "rajesh@test.com"
  }
}

script:post-response {
  const body = res.getBody();
  const id = body.data.id;
  if (!bru.getVar("studentId1")) {
    bru.setVar("studentId1", id);
  } else if (!bru.getVar("studentId2")) {
    bru.setVar("studentId2", id);
  } else if (!bru.getVar("studentId3")) {
    bru.setVar("studentId3", id);
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
