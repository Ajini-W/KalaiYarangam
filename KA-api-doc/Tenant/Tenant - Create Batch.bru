meta {
  name: Tenant - Create Batch
  type: http
  seq: 16
}

post {
  url: {{base-url}}/training/batches
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "name": "Batch June 2026",
    "course": "Full Stack Development",
    "capacity": 30
  }
}

script:post-response {
  const body = res.getBody();
  if (body.data) { bru.setVar("batchId", body.data.id); }
}

settings {
  encodeUrl: true
  timeout: 0
}
