  }
}

script:post-response {
  const body = res.getBody();
  const id = body.data.id;
  if (!bru.getVar("studentId1")) {
    bru.setVar("studentId1", id);
  } else if (!bru.getVar("studentId2")) {
    bru.setVar("studentId2", id);
  } else if (!bru.getVar("studentId3")) {
    bru.setVar("studentId3", id);
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
