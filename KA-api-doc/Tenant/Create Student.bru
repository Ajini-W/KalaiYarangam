meta {
  name: Create Student
  type: http
  seq: 17
}

post {
  url: {{base-url}}/training/students
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "name": "Rajesh Kumar",
    "phone": "9876543211",
    "email": "rajesh@gmail.com",
  
    "name":"rajesh",
