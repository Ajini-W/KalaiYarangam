      content-type: application/json; charset=utf-8
      content-length: 916
      etag: W/"394-z6LCZgQO/7kVCfRigUu+hEQlN10"
      date: Sun, 21 Jun 2026 10:51:37 GMT
      connection: keep-alive
      keep-alive: timeout=5
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "httpStatusCode": 201,
