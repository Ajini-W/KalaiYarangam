            "refreshToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIzNGZiN2IxNS0zNTAzLTQ0ZjctOGFmMC03NDlmMWI4OTFmYWYiLCJpYXQiOjE3ODIwMzkwOTcsImV4cCI6MTc4MjY0Mzg5N30.2eaXHTQHVmSQ81u-PSNSScnNHuqbXshBuaRG-BrFcJI"
          },
          "timestamp": "2026-06-21T10:51:37.845Z"
