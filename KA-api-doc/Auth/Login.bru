meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{base-url}}/auth/login
  body: json
  auth: inherit
}

body:json {
  {
    "type": "email",
    "email": "demo1@gmail.com",
    "password": "Demo@123",
    "rememberMe": true
  }
}

vars:post-response {
  accessToken: data.accessToken
  refreshToken: data.refreshToken
  isFirstLogin: data.isFirstLogin
}

script:post-response {
  const body = res.getBody();
  
  if (body.data) {
    bru.setVar("accessToken", body.data.accessToken);
    bru.setVar("refreshToken", body.data.refreshToken);
    bru.setVar("isFirstLogin", String(body.data.isFirstLogin));
  } else {
    console.error("Login failed:", body.message || "Unknown error");
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

example {
  name: Login with Email
  
  request: {
    url: {{base-url}}/auth/login
    method: POST
    mode: json
    body:json: {
      {
        "type": "email",
        "email": "sivabalanv2005@gmail.com",
        "password": "Demo@123",
        "rememberMe": true
      }
    }
  }
  
  response: {
    headers: {
      content-security-policy: default-src 'self';base-uri 'self';font-src 'self' https: data:;form-action 'self';frame-ancestors 'self';img-src 'self' data:;object-src 'none';script-src 'self';script-src-attr 'none';style-src 'self' https: 'unsafe-inline';upgrade-insecure-requests
