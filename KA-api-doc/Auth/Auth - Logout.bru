meta {
  name: Auth - Logout
  type: http
  seq: 5
}

post {
  url: {{base-url}}/auth/logout
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "refreshToken": "{{refreshToken}}"
  }
}

script:post {
  if (res.status === 200) {
    bru.setVar('accessToken', '');
    bru.setVar('refreshToken', '');
  }
}
