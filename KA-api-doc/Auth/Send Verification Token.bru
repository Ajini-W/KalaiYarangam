meta {
  name: Send Verification Token
  type: http
  seq: 11
}

post {
  url: {{base-url}}/auth/send-verification-token
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "semmozhiyan40@gmail.com"
  }
}

