meta {
  name: Logout
  type: http
  seq: 4
}

post {
  url: {{base-url}}/auth/logout
  body: json
  auth: inherit
}

body:json {
  {
    "refreshToken": "{{refreshToken}}"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

example {
  name: 201
  
  request: {
    url: {{base-url}}/auth/logout
