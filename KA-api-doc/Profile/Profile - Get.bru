meta {
  name: Profile - Get
  type: http
  seq: 1
}

get {
  url: {{base-url}}/auth/profile
  body: none
  auth: inherit
}

headers {
  Authorization: bearer {{accessToken}}
}

settings {
  encodeUrl: true
  timeout: 0
}

example {
  name: 200

  request: {
    url: {{base-url}}/auth/profile
    method: GET
    mode: none
    headers: {
      Authorization: bearer {{accessToken}}
    }
  }

  response: {
    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "httpStatusCode": 200,
          "message": "Profile retrieved",
          "data": {
            "id": "6c825958-60a1-4d03-aac8-19f9bbd650fd",
            "tenantId": "d1a2b3c4-...",
            "email": "user@example.com",
            "name": "John Doe",
            "phone": "+919876543210",
            "role": "STAFF",
            "status": "ACTIVE",
            "avatarUrl": null,
            "lastLoginAt": "2026-06-24T10:00:00.000Z",
            "createdAt": "2026-06-20T08:00:00.000Z",
            "profile": {
              "dateOfBirth": "1995-01-15",
              "gender": "MALE",
              "addressLine1": "123 Main St",
              "addressLine2": "Apt 4B",
              "city": "Coimbatore",
              "state": "Tamil Nadu",
              "pincode": "641001",
              "emergencyName": "Jane Doe",
