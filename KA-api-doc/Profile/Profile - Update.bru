            "phone": "+919876543210",
            "role": "STAFF",
            "status": "ACTIVE",
            "avatarUrl": null,
            "lastLoginAt": "2026-06-24T10:00:00.000Z",
            "createdAt": "2026-06-20T08:00:00.000Z",
            "profile": {
              "dateOfBirth": "1995-06-15",
              "gender": "MALE",
              "addressLine1": "456 New Street",
              "addressLine2": null,
