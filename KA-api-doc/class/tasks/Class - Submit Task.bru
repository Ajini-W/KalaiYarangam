meta {
  name: Class - Submit Task
  type: http
  seq: 11
}

post {
  url: {{base-url}}/class/tasks/{{taskId}}/submissions
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "studentId": "{{studentId1}}",
    "content": "Here is my completed homework assignment."
  }
}

vars:pre-request {
  studentId1: 1ac2e2d1-94ae-46c1-9f2b-4b9c1605364d
}

script:post-response {
  const body = res.getBody();
  if (body.data) { bru.setVar("submissionId", body.data.id); }
}

settings {
  encodeUrl: true
  timeout: 0
}
