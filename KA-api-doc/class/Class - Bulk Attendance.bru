meta {
  name: Class - Bulk Attendance
  type: http
  seq: 6
}

post {
  url: {{base-url}}/class/attendance/bulk
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "batchId": "{{batchId}}",
    "date": "2026-06-27",
    
    "defaultStatus": "PRESENT",
    "exceptions": [
      {
        "studentId": "{{studentId1}}",
        "status": "ABSENT",
        "remarks": "On leave"
      },
      {
        "studentId": "{{studentId2}}",
        "status": "LATE"
      }
    ]
  }
}

vars:pre-request {
  batchId: 69eaa17e-1903-4de4-a9a0-e6552aa397b2
  studentId1: 1ac2e2d1-94ae-46c1-9f2b-4b9c1605364d
  studentId2: 2e01f75b-3af1-4e08-a87d-2d1477f2cb1d
}

script:post-response {
  const body = res.getBody();
  if (body.data) { bru.setVar("attendanceSessionId2", body.data.id); }
}

settings {
  encodeUrl: true
  timeout: 0
}
