meta {
  name: Class - Generate Bulk Certificates
  type: http
  seq: 7
}

post {
  url: {{base-url}}/class/certificates/generate-bulk
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "batchId": "{{batchId}}",
    "templateId": "11111111-1111-4111-a111-111111111111",
    "studentIds": ["{{studentId1}}"],
    "issuedDate": "2026-06-26"
  }
}

vars:pre-request {
  batchId: 69eaa17e-1903-4de4-a9a0-e6552aa397b2
  studentId1: 1ac2e2d1-94ae-46c1-9f2b-4b9c1605364d
}

settings {
  encodeUrl: true
  timeout: 0
}
