meta {
  name: Class - Create Certificate
  type: http
  seq: 2
}

post {
  url: {{base-url}}/class/certificates
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "studentId": "{{studentId1}}",
    "templateId": "{{templateId}}",
    "batchId": "{{batchId}}",
    "courseName": "Full Stack Development",
    "issuedDate": "2026-06-26",
    "data": {
      "score": 92,
      "grade": "A"
    }
  }
}

vars:pre-request {
  studentId1: 1ac2e2d1-94ae-46c1-9f2b-4b9c1605364d
  batchId: 69eaa17e-1903-4de4-a9a0-e6552aa397b2
}

script:post-response {
  const body = res.getBody();
  if (body.data && body.data.id) {
    bru.setVar("certificateId", body.data.id);
    bru.setVar("certNumber", body.data.certNumber);
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
