meta {
  name: Class - Create Attendance
  type: http
  seq: 2
}

post {
  url: {{base-url}}/class/attendance
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "batchId": "{{batchId}}",
    "date": "2026-06-26",
    
    "records": [
      {
        "studentId": "{{studentId1}}",
        "status": "PRESENT",
        "checkInTime": "09:00"
      },
      {
        "studentId": "{{studentId2}}",
        "status": "ABSENT",
        "remarks": "No intimation"
      },
      {
        "studentId": "{{studentId3}}",
        "status": "LATE",
        "checkInTime": "10:15"
      }
    ]
  }
}

vars:pre-request {
  studentId1: 1ac2e2d1-94ae-46c1-9f2b-4b9c1605364d
  studentId2: 2e01f75b-3af1-4e08-a87d-2d1477f2cb1d
  studentId3: 71f571c6-c2e2-4c04-b819-7ce6d21d3336
  batchId: 69eaa17e-1903-4de4-a9a0-e6552aa397b2
}

script:post-response {
  const body = res.getBody();
  if (body.data) { bru.setVar("attendanceSessionId", body.data.id); }
}

settings {
  encodeUrl: true
  timeout: 0
}
